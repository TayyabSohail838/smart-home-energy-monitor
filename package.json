{
  "name": "energy-monitor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "//": "Scripts call node directly: the & in the folder path (Inovix & Co) breaks the Windows .cmd shims",
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "node node_modules/eslint/bin/eslint.js",
    "create-device": "node --env-file=.env.local scripts/create-device.js",
    "fake-device": "node --env-file=.env.local scripts/fake-device.js",
    "get-token": "node --env-file=.env.local scripts/get-token.js",
    "seed": "node --env-file=.env.local scripts/seed.js",
    "api": "node --env-file=.env.local scripts/api.js"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "resend": "^6.32.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4"
  }
}
